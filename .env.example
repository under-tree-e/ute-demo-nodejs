# Local development only. Do not reuse this file for Sandbox or production.
NODE_ENV=development
PORT=3000
DISABLE_METRICS=false
# Optional. Empty or unset keeps /metrics public. When set, scrapes must send
# `Authorization: Bearer <METRICS_TOKEN>`. Read at startup; restart after changing.
METRICS_TOKEN=
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# Replace locally. Production receives this value only from Vault Agent.
SESSION_SECRET=replace-with-a-local-development-secret
